{
  "name": "shrimphub-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:push": "pnpm --filter @shrimphub/database db:push",
    "db:push:prod": "pnpm --filter @shrimphub/database db:push:prod",
    "db:seed": "pnpm --filter @shrimphub/database db:seed",
    "db:studio": "pnpm --filter @shrimphub/database db:studio",
    "db:studio:prod": "pnpm --filter @shrimphub/database db:studio:prod"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@12.18.0"
}
